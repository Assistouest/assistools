<Application
    x:Class="Assistools.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Tokens d'espacement -->
            <Thickness x:Key="AppPageMargin">40,28,40,28</Thickness>
            <x:Double x:Key="AppSectionSpacing">20</x:Double>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!--  PALETTE DE MARQUE                                      -->
            <!--  Primaire  : #0069E2  /  Fond sombre : #0A1014          -->
            <!-- ═══════════════════════════════════════════════════════ -->

            <!-- Couleurs brutes -->
            <Color x:Key="BrandBlue">#FF0069E2</Color>
            <Color x:Key="BrandDark">#FF0A1014</Color>
            <Color x:Key="BrandWhite">#FFFFFFFF</Color>

            <!-- Palette dérivée de l'accent (light → dark) -->
            <Color x:Key="SystemAccentColor">#FF0069E2</Color>
            <Color x:Key="SystemAccentColorLight1">#FF2681E7</Color>
            <Color x:Key="SystemAccentColorLight2">#FF4D99EE</Color>
            <Color x:Key="SystemAccentColorLight3">#FF7BB8F5</Color>
            <Color x:Key="SystemAccentColorDark1">#FF0054C0</Color>
            <Color x:Key="SystemAccentColorDark2">#FF003E8C</Color>
            <Color x:Key="SystemAccentColorDark3">#FF002960</Color>

            <!-- Pinceaux nommés utilisables directement en XAML -->
            <SolidColorBrush x:Key="BrandBlueBrush"  Color="{StaticResource BrandBlue}"  />
            <SolidColorBrush x:Key="BrandDarkBrush"  Color="{StaticResource BrandDark}"  />
            <SolidColorBrush x:Key="BrandWhiteBrush" Color="{StaticResource BrandWhite}" />

            <!-- Card standard utilisée pour les métriques et conteneurs -->
            <Style x:Key="AppCardStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="MinHeight" Value="72" />
            </Style>

            <!-- Ligne d'item dans un Expander : titre + description + action -->
            <Style x:Key="AppItemRowStyle" TargetType="Grid">
                <Setter Property="Padding" Value="0,14,0,14" />
            </Style>

            <!-- Titre d'action (item) -->
            <Style x:Key="AppItemTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />

            <!-- Description d'action (item) -->
            <Style x:Key="AppItemDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Header d'Expander : icône + titre -->
            <Style x:Key="AppExpanderHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Bouton héro (action principale d'une page) -->
            <Style x:Key="AppHeroButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Height" Value="60" />
                <Setter Property="MinWidth" Value="320" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="20,0,20,0" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
