<Page
    NavigationCacheMode="Required"
    x:Class="Assistools.Pages.PageAuto"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="36,28,36,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- SECTION HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Tableau de bord" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" />
                    <TextBlock
                        x:Name="ScoreSubtitle"
                        Text="Vue d'ensemble de l'état de votre ordinateur."
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button 
                    x:Name="BtnActualiser" 
                    Grid.Column="1" 
                    Height="36" 
                    Width="36" 
                    Click="BtnActualiser_Click" 
                    ToolTipService.ToolTip="Actualiser le tableau de bord"
                    Background="Transparent"
                    BorderThickness="0">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </Grid>

            <!-- MAIN GRID CONTENT -->
            <Grid Grid.Row="1" ColumnSpacing="24" RowSpacing="24">
                <Grid.ColumnDefinitions>
                    <!-- Left Hero Card -->
                    <ColumnDefinition Width="320" />
                    <!-- Right Metrics & Details -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDE: Two cards stacked vertically -->
                <StackPanel Grid.Column="0" Spacing="16" VerticalAlignment="Top">

                    <!-- Card 1: Score gauge + action buttons -->
                    <Border 
                        CornerRadius="8" 
                        BorderThickness="1" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="État général" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                            <!-- Large Circle Gauge -->
                            <Grid Width="130" Height="130" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="130" Height="130" Stroke="{ThemeResource ControlStrokeColorSecondaryBrush}" StrokeThickness="10" />
                                <Ellipse
                                    x:Name="ScoreCircle"
                                    Width="130" Height="130"
                                    Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                    StrokeThickness="10"
                                    StrokeDashCap="Round"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-90" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="ScoreText" Text="--" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" LineHeight="38" />
                                    <TextBlock x:Name="ScoreLabel" Text="Calcul…" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <MenuFlyoutSeparator />

                            <!-- Checkbox and Action Buttons -->
                            <StackPanel Spacing="12">
                                <CheckBox x:Name="CbRestore" IsChecked="True">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="Créer un point de restauration" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="Recommandé avant maintenance" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>

                                <Button
                                    x:Name="BtnDemarrer"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Height="48"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,4,0,0"
                                    Click="BtnDemarrer_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE768;" FontSize="15" />
                                        <TextBlock x:Name="BtnDemarrerText" Text="Lancer la maintenance" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button 
                                    x:Name="BtnAnnuler" 
                                    Content="Annuler la maintenance" 
                                    Height="40" 
                                    HorizontalAlignment="Stretch" 
                                    Visibility="Collapsed" 
                                    Click="BtnAnnuler_Click" />

                                <ProgressBar x:Name="ProgressGlobal" Visibility="Collapsed" Height="6" CornerRadius="3" />
                                <InfoBar x:Name="InfoStatus" IsOpen="False" IsClosable="False" Severity="Informational" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Dernière maintenance -->
                    <Border
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Padding="20">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="IconMaint" Glyph="" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="Dernière maintenance" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="ValMaint" Text="--" FontSize="20" FontWeight="Bold" />
                            <TextBlock x:Name="DetailMaint" Text="" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- RIGHT SIDE: System Metrics & Operations List -->
                <StackPanel Grid.Column="1" Spacing="24">
                    
                    <!-- Metrics Row -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Storage Card -->
                        <Border Grid.Column="0" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16,14">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                    <FontIcon x:Name="IconDisque" Glyph="" FontSize="15" />
                                    <TextBlock Text="Stockage" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="ValDisque" Text="--" FontSize="17" FontWeight="Bold" />
                                <ProgressBar x:Name="ProgressDisque" Minimum="0" Maximum="100" Value="0" Height="4" CornerRadius="2" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Background="{ThemeResource ControlStrokeColorSecondaryBrush}" Margin="0,4,0,4" />
                                <TextBlock x:Name="DetailDisque" Text="" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="DetailDisque2" Text="" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Memory Card -->
                        <Border Grid.Column="1" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16,14">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                    <FontIcon x:Name="IconMemoire" Glyph="" FontSize="15" />
                                    <TextBlock Text="Mémoire vive" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="ValMemoire" Text="--" FontSize="17" FontWeight="Bold" />
                                <ProgressBar x:Name="ProgressMemoire" Minimum="0" Maximum="100" Value="0" Height="4" CornerRadius="2" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Background="{ThemeResource ControlStrokeColorSecondaryBrush}" Margin="0,4,0,4" />
                                <TextBlock x:Name="DetailMemoire" Text="" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="DetailMemoire2" Text="" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- CPU Card -->
                        <Border Grid.Column="2" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16,14">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                    <FontIcon Glyph="&#xE950;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Processeur" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="ValCpu" Text="--" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" />
                                <TextBlock x:Name="DetailCpu" Text="" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Operations Card -->
                    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel>
                            <Border Padding="16,12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Opérations de maintenance" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Sélection" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                </Grid>
                            </Border>

                            <StackPanel x:Name="EtapesPanel" Padding="8" Spacing="4" />
                        </StackPanel>
                    </Border>
                    
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>

