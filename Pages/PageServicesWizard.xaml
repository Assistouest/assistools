<Page
    NavigationCacheMode="Required"
    x:Class="Assistools.Pages.PageServicesWizard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource AppPageMargin}" Spacing="20" HorizontalAlignment="Stretch">

            <!-- En-tête -->
            <StackPanel Spacing="6">
                <TextBlock Text="Optimisation des services" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" />
                <TextBlock
                    Text="Désactivez les services Windows que vous n'utilisez pas. Un assistant pas-à-pas vous pose une question par usage. Une sauvegarde est créée automatiquement pour tout restaurer en un clic."
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- Bandeau restauration (visible si backup existant) -->
            <InfoBar
                x:Name="RestoreBar"
                IsOpen="False"
                Severity="Informational"
                Title="Configuration précédente disponible"
                Message="Une sauvegarde d'état des services existe. Vous pouvez tout restaurer.">
                <InfoBar.ActionButton>
                    <Button x:Name="BtnRestore" Content="Restaurer" Click="BtnRestore_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- PANEL WELCOME                                                       -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <StackPanel x:Name="PanelWelcome" Spacing="16">
                <Border Style="{StaticResource AppCardStyle}" Padding="20">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE9CE;" FontSize="22" Foreground="{StaticResource BrandBlueBrush}" />
                            <TextBlock Text="Comment ça fonctionne ?" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="• L'assistant vous pose une série de questions sur votre usage du PC (impression, Bluetooth, Xbox, etc.)." /><LineBreak />
                            <Run Text="• Pour chaque " /><Run Text="Non" FontWeight="SemiBold" /><Run Text=", les services correspondants seront désactivés." /><LineBreak />
                            <Run Text="• L'état initial est sauvegardé : un bouton " /><Run Text="Restaurer" FontWeight="SemiBold" /><Run Text=" remet tout en place à tout moment." /><LineBreak />
                            <Run Text="• Seules les catégories pertinentes pour ce PC sont proposées." />
                        </TextBlock>
                        <TextBlock x:Name="TxtWelcomeCount"
                                   Text=""
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <Button x:Name="BtnStart"
                        Style="{StaticResource AppHeroButtonStyle}"
                        Content="Commencer l'assistant"
                        HorizontalAlignment="Left"
                        Click="BtnStart_Click" />
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- PANEL QUESTION                                                      -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <StackPanel x:Name="PanelQuestion" Spacing="16" Visibility="Collapsed">

                <!-- Barre de progression -->
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="TxtStepIndicator" Text="Étape 1 / 17"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ProgressBar x:Name="StepProgress" Minimum="0" Maximum="100" Value="0" Height="4" />
                </StackPanel>

                <!-- Carte question -->
                <Border Style="{StaticResource AppCardStyle}" Padding="24">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <Border Width="48" Height="48" CornerRadius="10" Background="{StaticResource BrandBlueBrush}" VerticalAlignment="Top">
                                <FontIcon x:Name="QIcon" Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" />
                            </Border>
                            <TextBlock x:Name="QText" Text=""
                                       Style="{ThemeResource SubtitleTextBlockStyle}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnYes" Grid.Column="0" HorizontalAlignment="Stretch" Height="64"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Click="BtnYes_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE73E;" FontSize="16" />
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Oui, je l'utilise" FontWeight="SemiBold" />
                                        <TextBlock Text="Conserver ces services" FontSize="11" Opacity="0.85" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnNo" Grid.Column="1" HorizontalAlignment="Stretch" Height="64"
                                    Click="BtnNo_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE711;" FontSize="16" />
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Non, je ne l'utilise pas" FontWeight="SemiBold" />
                                        <TextBlock Text="Désactiver ces services" FontSize="11" Opacity="0.85" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Conséquences -->
                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="6" Padding="14,10">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="QIfYes" Text="" TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="QIfNo" Text="" TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <TextBlock x:Name="QServicesHeader" Text="Voir les services concernés" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            </Expander.Header>
                            <StackPanel x:Name="QServicesList" Spacing="8" Padding="0,8" />
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Navigation bas -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnPrev" Content="← Précédent" Click="BtnPrev_Click" />
                    <Button Grid.Column="2" x:Name="BtnSkip" Content="Passer cette question →" Click="BtnSkip_Click" />
                </Grid>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- PANEL SUMMARY                                                       -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <StackPanel x:Name="PanelSummary" Spacing="16" Visibility="Collapsed">
                <Border Style="{StaticResource AppCardStyle}" Padding="20">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE9D5;" FontSize="22" Foreground="{StaticResource BrandBlueBrush}" />
                            <TextBlock Text="Récapitulatif" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="TxtSummaryCount" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel x:Name="SummaryList" Spacing="6" />
                    </StackPanel>
                </Border>

                <InfoBar IsOpen="True" IsClosable="False" Severity="Warning"
                         Title="Avant d'appliquer"
                         Message="L'état initial de chaque service va être sauvegardé. Vous pourrez tout restaurer en un clic depuis cette page." />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnSummaryBack" Content="← Revoir les questions" Click="BtnSummaryBack_Click" />
                    <Button Grid.Column="2" x:Name="BtnApply" Style="{ThemeResource AccentButtonStyle}"
                            Content="Appliquer et désactiver" Click="BtnApply_Click" />
                </Grid>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- PANEL RESULT                                                        -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <StackPanel x:Name="PanelResult" Spacing="16" Visibility="Collapsed">
                <InfoBar x:Name="ResultBar" IsOpen="True" IsClosable="False"
                         Severity="Success" Title="Opération terminée" Message="" />

                <Border Style="{StaticResource AppCardStyle}" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Journal" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280">
                            <TextBlock x:Name="ResultLog" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Button x:Name="BtnDone" Content="Retour à l'accueil" Click="BtnDone_Click" HorizontalAlignment="Left" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
