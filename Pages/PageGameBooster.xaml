<Page
    NavigationCacheMode="Required"
    x:Class="Assistools.Pages.PageGameBooster"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Style pour les cartes de profil - Version ToggleButton Corrigée -->
        <Style x:Key="ProfileCardStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                            <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource SystemAccentColorLight1}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootGrid"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="0.98" Duration="0:0:0.05" />
                                            <DoubleAnimation Storyboard.TargetName="RootGrid"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="0.98" Duration="0:0:0.05" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.BorderBrush" Value="{StaticResource BrandBlueBrush}" />
                                            <Setter Target="RootGrid.BorderThickness" Value="2" />
                                            <Setter Target="SelectionIndicator.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                            <Setter Target="RootGrid.BorderThickness" Value="1" />
                                            <Setter Target="SelectionIndicator.Visibility" Value="Collapsed" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                            <Setter Target="RootGrid.BorderThickness" Value="1" />
                                            <Setter Target="SelectionIndicator.Visibility" Value="Collapsed" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Grid>
                                <!-- Le ContentPresenter affiche ce qui est mis dans <ToggleButton.Content> -->
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                
                                <!-- Indicateur de sélection -->
                                <FontIcon x:Name="SelectionIndicator" Glyph="&#xE73E;" FontSize="16" 
                                          Foreground="{StaticResource BrandBlueBrush}" 
                                          HorizontalAlignment="Right" VerticalAlignment="Top" 
                                          Margin="12"
                                          Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style pour les indicateurs d'état -->
        <Style x:Key="StatusIndicatorStyle" TargetType="Border">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="{StaticResource AppPageMargin}" Spacing="32" HorizontalAlignment="Stretch">

            <!-- 1. HERO SECTION -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Game Booster" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border x:Name="StatusDot" Style="{StaticResource StatusIndicatorStyle}" Background="Gray" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="Moteur éteint" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock x:Name="StatusDesc" 
                               Text="Sélectionnez un profil et activez le booster pour optimiser votre session de jeu." 
                               Style="{StaticResource BodyTextBlockStyle}" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Button x:Name="BtnToggle" Grid.Column="1" 
                        Style="{StaticResource AppHeroButtonStyle}" 
                        Content="Activer le Booster" 
                        Click="BtnToggle_Click" />
            </Grid>

            <!-- 2. PROFILES SECTION -->
            <StackPanel Spacing="16">
                <TextBlock Text="Profils d'optimisation" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Grid x:Name="ProfilesGrid" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.Resources>
                        <Style TargetType="RadioButton" BasedOn="{StaticResource ProfileCardStyle}">
                            <Setter Property="Margin" Value="4" />
                            <Setter Property="Height" Value="150" />
                        </Style>
                        <!-- Styles internes pour le contenu des boutons -->
                        <Style x:Key="CardIconStyle" TargetType="FontIcon">
                            <Setter Property="FontSize" Value="24" />
                            <Setter Property="Foreground" Value="{StaticResource BrandBlueBrush}" />
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="Margin" Value="0,0,0,12" />
                        </Style>
                        <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                            <Setter Property="Margin" Value="0,0,0,4" />
                        </Style>
                        <Style x:Key="CardDescStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </Grid.Resources>

                    <RadioButton x:Name="BtnGamer" Grid.Column="0" GroupName="ProfileGroup" Checked="Profile_Checked" Tag="Competitif">
                        <StackPanel>
                            <FontIcon Glyph="&#xE945;" Style="{StaticResource CardIconStyle}" />
                            <TextBlock Text="Compétitif" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="Latence zéro. Nagle off, 0.5ms timer, cœurs 100%, plan Ultime." Style="{StaticResource CardDescStyle}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="BtnStreamer" Grid.Column="1" GroupName="ProfileGroup" Checked="Profile_Checked" Tag="Gamer">
                        <StackPanel>
                            <FontIcon Glyph="&#xE7FC;" Style="{StaticResource CardIconStyle}" />
                            <TextBlock Text="Gamer" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="Haute performance, services optimisés, réseau boosté." Style="{StaticResource CardDescStyle}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="BtnMultitask" Grid.Column="2" GroupName="ProfileGroup" Checked="Profile_Checked" Tag="Streamer">
                        <StackPanel>
                            <FontIcon Glyph="&#xE93E;" Style="{StaticResource CardIconStyle}" />
                            <TextBlock Text="Streamer" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="Gaming + OBS simultané, encodage fluide garanti." Style="{StaticResource CardDescStyle}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="BtnCustom" Grid.Column="3" GroupName="ProfileGroup" Checked="Profile_Checked" Tag="Custom">
                        <StackPanel>
                            <FontIcon Glyph="&#xE713;" Style="{StaticResource CardIconStyle}" />
                            <TextBlock Text="Avancé" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="Contrôle total : configurez chaque paramètre." Style="{StaticResource CardDescStyle}" />
                        </StackPanel>
                    </RadioButton>
                </Grid>
            </StackPanel>

            <!-- 3. DASHBOARD / MONITORING -->
            <StackPanel x:Name="MonitoringSection" Spacing="16" Visibility="Collapsed">
                <TextBlock Text="Activité en temps réel" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Jeux détectés -->
                    <Border Grid.Column="0" Style="{StaticResource AppCardStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE9D2;" FontSize="16" Foreground="{StaticResource BrandBlueBrush}" />
                                <TextBlock Text="Jeux détectés" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <ListView x:Name="DetectedGamesList" SelectionMode="None" MaxHeight="120">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,4">
                                            <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="Green" />
                                            <TextBlock Text="{Binding}" Style="{StaticResource BodyTextBlockStyle}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="NoGameText" Text="Aucun jeu détecté pour le moment..." 
                                       Style="{StaticResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                       FontStyle="Italic" />
                        </StackPanel>
                    </Border>

                    <!-- Optimisations actives -->
                    <Border Grid.Column="1" Style="{StaticResource AppCardStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE945;" FontSize="16" Foreground="{StaticResource BrandBlueBrush}" />
                                <TextBlock Text="Optimisations actives" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel x:Name="ActiveOptimizationsStack" Spacing="4">
                                <!-- Rempli dynamiquement -->
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- 4. PROFILE DETAILS / ADVANCED OPTIONS -->
            <Expander x:Name="ProfileDetailsExpander"
                      IsExpanded="True"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="ProfileDetailsIcon" Glyph="&#xE946;" FontSize="16" Foreground="{StaticResource BrandBlueBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ProfileDetailsTitle" Text="Détails du profil" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                </Expander.Header>

                <!-- Lecture seule : Compétitif / Gamer / Streamer -->
                <StackPanel x:Name="ProfileReadOnlyPanel" Padding="0,8,0,8" Spacing="0" Visibility="Visible">
                    <StackPanel x:Name="ProfileInfoStack" Spacing="0" />
                </StackPanel>

            </Expander>

            <!-- Custom : éditable — séparé pour ne pas interférer avec le panel lecture seule -->
            <Expander x:Name="AdvancedOptionsExpander"
                      Header="Réglages personnalisés"
                      IsExpanded="True"
                      Visibility="Collapsed"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <StackPanel Padding="0,8,0,8" Spacing="16">
                    <Grid Style="{StaticResource AppItemRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Game Mode Windows" Style="{StaticResource AppItemTitleStyle}" />
                            <TextBlock Text="Priorise les ressources système pour le processus du jeu." Style="{StaticResource AppItemDescriptionStyle}" />
                        </StackPanel>
                        <CheckBox x:Name="ChkGameMode" Grid.Column="1" IsChecked="True" />
                    </Grid>
                    <MenuFlyoutSeparator />
                    <Grid Style="{StaticResource AppItemRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Xbox Game Bar" Style="{StaticResource AppItemTitleStyle}" />
                            <TextBlock Text="Désactive l'overlay et l'enregistrement DVR pour gagner des FPS." Style="{StaticResource AppItemDescriptionStyle}" />
                        </StackPanel>
                        <CheckBox x:Name="ChkXboxGameBar" Grid.Column="1" IsChecked="True" />
                    </Grid>
                    <MenuFlyoutSeparator />
                    <Grid Style="{StaticResource AppItemRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Priorité CPU Haute" Style="{StaticResource AppItemTitleStyle}" />
                            <TextBlock Text="Définit automatiquement le jeu en priorité 'Haute'." Style="{StaticResource AppItemDescriptionStyle}" />
                        </StackPanel>
                        <CheckBox x:Name="ChkHighPriority" Grid.Column="1" IsChecked="True" />
                    </Grid>
                    <MenuFlyoutSeparator />
                    <Grid Style="{StaticResource AppItemRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Réseau (Nagle + Throttling)" Style="{StaticResource AppItemTitleStyle}" />
                            <TextBlock Text="Désactive le buffering TCP et la limitation bande passante." Style="{StaticResource AppItemDescriptionStyle}" />
                        </StackPanel>
                        <CheckBox x:Name="ChkRegistry" Grid.Column="1" IsChecked="True" />
                    </Grid>
                    <MenuFlyoutSeparator />
                    <Grid Style="{StaticResource AppItemRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Services Windows" Style="{StaticResource AppItemTitleStyle}" />
                            <TextBlock Text="Arrête temporairement les services inutiles." Style="{StaticResource AppItemDescriptionStyle}" />
                        </StackPanel>
                        <CheckBox x:Name="ChkServices" Grid.Column="1" IsChecked="True" />
                    </Grid>
                    <MenuFlyoutSeparator />
                    <Grid Style="{StaticResource AppItemRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Plan d'alimentation" Style="{StaticResource AppItemTitleStyle}" />
                            <TextBlock Text="Bascule sur 'Haute Performance' pendant le jeu." Style="{StaticResource AppItemDescriptionStyle}" />
                        </StackPanel>
                        <CheckBox x:Name="ChkHighPerfPower" Grid.Column="1" IsChecked="True" />
                    </Grid>
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</Page>
