<Page
    NavigationCacheMode="Required"
    x:Class="Assistools.Pages.PageRapport"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="40,56,40,40" Spacing="28" MaxWidth="960" HorizontalAlignment="Center">

            <!-- EN-TÊTE -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Rapport système" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" />
                    <TextBlock Text="Fiche technique complète des composants matériels et logiciels."
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button x:Name="BtnExportPdf" Grid.Column="1"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="BtnExportPdf_Click" IsEnabled="False" Height="40">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="Exporter le rapport" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- CHARGEMENT -->
            <Grid x:Name="LoadingPanel" Height="280">
                <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressRing x:Name="LoadingRing" Width="48" Height="48" IsActive="True" />
                    <TextBlock Text="Analyse du matériel en cours…"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- CONTENU PRINCIPAL -->
            <StackPanel x:Name="ReportPanel" Spacing="32" Visibility="Collapsed">

                <!-- ══ SYNTHÈSE ══ -->
                <StackPanel Spacing="16">
                    <TextBlock Text="Vue d'ensemble" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                    <Grid RowSpacing="12" ColumnSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource AppCardStyle}" Padding="16">
                            <StackPanel Spacing="12">
                                <Border Width="36" Height="36" CornerRadius="8" Background="#FF0069E2" HorizontalAlignment="Left">
                                    <FontIcon Glyph="&#xE770;" FontSize="16" Foreground="White" />
                                </Border>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Système" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtOsName" Text="--" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="TxtBoardName" Text="--" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource AppCardStyle}" Padding="16">
                            <StackPanel Spacing="12">
                                <Border Width="36" Height="36" CornerRadius="8" Background="#FF0069E2" HorizontalAlignment="Left">
                                    <FontIcon Glyph="&#xE950;" FontSize="16" Foreground="White" />
                                </Border>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Processeur" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtCpuName" Text="--" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="TxtCpuDetails" Text="--" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource AppCardStyle}" Padding="16">
                            <StackPanel Spacing="12">
                                <Border Width="36" Height="36" CornerRadius="8" Background="#FF0069E2" HorizontalAlignment="Left">
                                    <FontIcon Glyph="&#xE964;" FontSize="16" Foreground="White" />
                                </Border>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Mémoire RAM" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtRamSummary" Text="--" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="TxtRamSlots" Text="--" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource AppCardStyle}" Padding="16">
                            <StackPanel Spacing="12">
                                <Border Width="36" Height="36" CornerRadius="8" Background="#FF0069E2" HorizontalAlignment="Left">
                                    <FontIcon Glyph="&#xE7B7;" FontSize="16" Foreground="White" />
                                </Border>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Carte graphique" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtGpuName" Text="--" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="TxtGpuVram" Text="--" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource AppCardStyle}" Padding="16">
                            <StackPanel Spacing="12">
                                <Border Width="36" Height="36" CornerRadius="8" Background="#FF0069E2" HorizontalAlignment="Left">
                                    <FontIcon Glyph="&#xE7C1;" FontSize="16" Foreground="White" />
                                </Border>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Stockage" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtStorageSummary" Text="--" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="TxtStoragePartitions" Text="--" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- ══ SÉCURITÉ ══ -->
                <StackPanel Spacing="16">
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock Text="Sécurité" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource AppCardStyle}" Padding="16">
                            <StackPanel Spacing="12">
                                <Border Width="36" Height="36" CornerRadius="8" HorizontalAlignment="Left" x:Name="BorderDefender" Background="#FF0069E2">
                                    <FontIcon Glyph="&#xEA18;" FontSize="16" Foreground="White" />
                                </Border>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Windows Defender" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtDefenderStatus" Text="--" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="TxtDefenderEngine" Text="--" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource AppCardStyle}" Padding="16">
                            <StackPanel Spacing="12">
                                <Border Width="36" Height="36" CornerRadius="8" HorizontalAlignment="Left" x:Name="BorderFirewall" Background="#FF0069E2">
                                    <FontIcon Glyph="&#xE83D;" FontSize="16" Foreground="White" />
                                </Border>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Pare-feu" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtFirewallStatus" Text="--" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="TxtFirewallProfiles" Text="--" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource AppCardStyle}" Padding="16">
                            <StackPanel Spacing="12">
                                <Border Width="36" Height="36" CornerRadius="8" HorizontalAlignment="Left" x:Name="BorderBios" Background="#FF0069E2">
                                    <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="White" />
                                </Border>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="BIOS / TPM" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtBiosMode" Text="--" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="TxtTpmStatus" Text="--" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- ══ DÉTAIL PAR COMPOSANT ══ -->
                <StackPanel Spacing="8">
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock Text="Détail par composant" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" Margin="0,8,0,4" />

                    <Expander Header="Mémoire RAM, modules installés" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="PanelRamDetails" Spacing="0" Margin="0,4,0,4" />
                    </Expander>

                    <Expander Header="Stockage, disques et partitions" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="0" Margin="0,4,0,8">
                            <TextBlock Text="Disques physiques" FontSize="12" FontWeight="SemiBold"
                                       Margin="16,12,16,8" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:Name="PanelDisksDetails" Spacing="0" />
                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="16,8,16,8" />
                            <TextBlock Text="Partitions" FontSize="12" FontWeight="SemiBold"
                                       Margin="16,0,16,8" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:Name="PanelVolumesDetails" Spacing="0" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="Réseau embarqué, Wi-Fi, Ethernet, Bluetooth" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="PanelOnboard" Spacing="0" Margin="0,4,0,4" />
                    </Expander>

                    <Expander Header="Carte graphique" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="PanelGpuDetails" Spacing="0" Margin="0,4,0,4" />
                    </Expander>

                    <Expander Header="Processeur et carte mère" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Padding="16,12,16,12" Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Processeur" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailCpuName" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Fabricant / Architecture" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailCpuMfg" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Cœurs / Threads" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailCpuCores" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Fréquence maximale" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailCpuSpeed" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Socket / Cache" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailCpuSocket" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Virtualisation" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailCpuVirt" FontSize="12" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Fabricant carte mère" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailBoardManufacturer" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Modèle" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailBoardProduct" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="N° de série" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailBoardSerial" FontSize="12" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="BIOS" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailBiosMfg" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Version / Date" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailBiosVersion" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Mode démarrage" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailBiosMode" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="TPM" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailTpm" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Secure Boot" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailSecureBoot" FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Système d'exploitation" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Padding="16,12,16,12" Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Édition" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailOsName" FontSize="13" FontWeight="SemiBold" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Version / Build" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailOsVersion" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Architecture" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailOsArch" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Installé le" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailOsInstall" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Dernier démarrage" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailOsBoot" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Fonctionnement" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailOsUptime" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Fuseau horaire" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailOsTimezone" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Nom de l'ordinateur" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailOsComputer" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Domaine" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailOsDomain" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Utilisateur" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailOsUser" FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Sécurité Windows" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Padding="16,12,16,12" Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Antivirus" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailDefEnabled" FontSize="12" FontWeight="SemiBold" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Protection temps réel" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailDefRealtime" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Définitions" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailDefUpToDate" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Version moteur" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailDefEngine" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Signatures mises à jour" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailDefSigs" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Dernière analyse complète" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailDefFullScan" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Dernière analyse rapide" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailDefQuickScan" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="UAC" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailUac" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Antivirus tiers" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailThirdPartyAv" FontSize="12" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <TextBlock Text="Mises à jour récentes" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:Name="PanelUpdates" Spacing="0" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="Maintenance" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Padding="16,12,16,12" Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource AppCardStyle}" Padding="14">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Dernière maintenance" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="TxtMaintDate" Text="--" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource AppCardStyle}" Padding="14">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Nettoyage disque" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="TxtMaintClean" Text="--" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Name="TxtMaintCleanDetail" Text="" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource AppCardStyle}" Padding="14">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Réparation système" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="TxtMaintRepair" Text="--" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Name="TxtMaintRepairDetail" Text="" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="TxtMaintOpsTitle" Text="Opérations de la session"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:Name="PanelMaintOps" Spacing="0" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="Réseau" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="PanelNetwork" Spacing="0" Margin="0,4,0,4" />
                    </Expander>

                    <Expander x:Name="ExpanderBattery" Header="Batterie" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="Collapsed">
                        <StackPanel Padding="16,12,16,12" Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="État de santé" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailBatHealth" FontSize="13" FontWeight="SemiBold" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Capacité de conception" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailBatDesign" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Capacité réelle" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailBatFull" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Cycles de charge" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailBatCycles" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="État de charge" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailBatStatus" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Autonomie estimée" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DetailBatRuntime" FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Applications installées" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="0" Margin="0,4,0,4">
                            <TextBlock x:Name="TxtAppsCount" Text="" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="16,8,16,8" />
                            <StackPanel x:Name="PanelApps" Spacing="0" />
                        </StackPanel>
                    </Expander>

                </StackPanel>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
