<UserControl
    x:Class="Assistools.Controls.LogsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Expander
        x:Name="LogsExpander"
        Header="Logs d'exécution"
        IsExpanded="False"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch">
        <Border
            Height="200"
            CornerRadius="0,0,4,4"
            Background="#FF1E1E1E">
            <ScrollViewer
                x:Name="LogsScroller"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto"
                Padding="12,8">
                <TextBlock
                    x:Name="LogsText"
                    FontFamily="Consolas"
                    FontSize="11"
                    Foreground="#FFCCCCCC"
                    TextWrapping="NoWrap"
                    IsTextSelectionEnabled="True" />
            </ScrollViewer>
        </Border>
    </Expander>
</UserControl>
